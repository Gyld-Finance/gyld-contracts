# Copy to roles.env (git-ignored). From lib/gyld-contracts, load it AFTER the vault list:
#   set -a; . script-bsc/fordefi-roles.bsc-testnet.env; . tools/fordefi-replay/roles.env; set +a
# Addresses are public. Credentials: set the NAMES below from your secret store at
# run time; never commit values. PEM = Fordefi API-request signing key (PKCS#8
# or SEC1), as content or a file path - it is not a blockchain key.

CHAIN_ID=97
RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
EXPLORER_TX_URL=https://testnet.bscscan.com/tx/
# FORDEFI_APPROVAL_TIMEOUT_MS=3600000   # max wait for Fordefi approval+signing per tx
# RECEIPT_TIMEOUT_MS=600000             # max wait for the on-chain receipt per tx
# SIGN_VAULT_LABEL=CONTRACT_ADMIN       # sign-message.mjs vault

# Vault addresses: every forge `from` must match one of these. Taken from
# script-bsc/fordefi-roles.bsc-testnet.env (the one list of addresses).
# Not the deployer: STACK_DEPLOYER is the KMS deployer and must map to no vault (all-Fordefi
# only: FORDEFI_DEPLOYER_ADDRESS=$STACK_DEPLOYER plus its credentials).
FORDEFI_CONTRACT_ADMIN_ADDRESS=$FORDEFI_CONTRACT_ADMIN
FORDEFI_FREEZE_ADDRESS=$FORDEFI_FREEZE
FORDEFI_SWAP_PAUSE_ADDRESS=$FORDEFI_SWAP_PAUSE
FORDEFI_NAV_FEEDER_ADDRESS=$FORDEFI_NAV_FEEDER
FORDEFI_SUBSCRIBER_ADDRESS=$FORDEFI_SUBSCRIBER
FORDEFI_BURN_ROLE_ADDRESS=$FORDEFI_BURN_ROLE
FORDEFI_WHITELISTER_ADDRESS=$FORDEFI_WHITELISTER
FORDEFI_SWAP_TREASURER_ADDRESS=$FORDEFI_SWAP_TREASURER
FORDEFI_QUOTE_SIGNER_ADDRESS=$FORDEFI_QUOTE_SIGNER
FORDEFI_BLOCKLIST_UPDATER_ADDRESS=$FORDEFI_BLOCKLIST_UPDATER
FORDEFI_SWAP_DISTRIBUTION_ADDRESS=$FORDEFI_SWAP_DISTRIBUTION

# Per signing vault (CONTRACT_ADMIN, NAV_FEEDER, SUBSCRIBER, WHITELISTER,
# BLOCKLIST_UPDATER; other labels only if they sign): the Fordefi vault ID (UUID, from
# the vault's page in the Fordefi console: the id in its URL / vault details) and the
# API-user credentials.
# FORDEFI_CONTRACT_ADMIN_VAULT_ID
# FORDEFI_CONTRACT_ADMIN_API_TOKEN
# FORDEFI_CONTRACT_ADMIN_PRIVATE_KEY_PEM
# FORDEFI_NAV_FEEDER_VAULT_ID
# FORDEFI_NAV_FEEDER_API_TOKEN
# FORDEFI_NAV_FEEDER_PRIVATE_KEY_PEM
# FORDEFI_SUBSCRIBER_VAULT_ID
# FORDEFI_SUBSCRIBER_API_TOKEN
# FORDEFI_SUBSCRIBER_PRIVATE_KEY_PEM
# FORDEFI_WHITELISTER_VAULT_ID
# FORDEFI_WHITELISTER_API_TOKEN
# FORDEFI_WHITELISTER_PRIVATE_KEY_PEM
# FORDEFI_BLOCKLIST_UPDATER_VAULT_ID
# FORDEFI_BLOCKLIST_UPDATER_API_TOKEN
# FORDEFI_BLOCKLIST_UPDATER_PRIVATE_KEY_PEM

# Set only when approving a reviewed plan (printed by plan mode):
# PLAN_SHA256=
