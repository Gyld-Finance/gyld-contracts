# ══════════════════════════════════════════════════════════════════════════════
# READ FIRST — dev chains vs production chains (GYL-1135)
#
# The deploy scripts classify chains with an ALLOWLIST (contracts/script/lib/
# DeployGuards.sol): 31337 (Anvil) and 11155111 (Sepolia) are development chains.
# EVERY other chain — Base 8453, Arbitrum, Ethereum, and any chain that does not
# exist yet — is production and takes the strict path:
#
#   * every variable marked [PROD-REQUIRED] below must be set;
#   * none of them may be the deployer EOA that broadcasts the transaction;
#   * TIMELOCK_DELAY_SECONDS must be >= 172800 (48 hours);
#   * the final role topology is asserted in-band and a mismatch aborts the deploy.
#
# On a dev chain the [PROD-REQUIRED] variables may be omitted and fall back to the
# deployer, which is what makes the zero-config Anvil flow work.
# ══════════════════════════════════════════════════════════════════════════════

PRIVKEY=0xYOUR_PRIVATE_KEY_HERE
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
RPC=https://ethereum-sepolia-rpc.publicnode.com

# [PROD-REQUIRED] TimelockController delay, in seconds.
# 172800 = 48 hours, the production minimum enforced by DeployGuards.
# DO NOT ship 0 here. A zero delay makes the timelock a rubber stamp: it still
# "holds" every admin role, but anything can be scheduled and executed in the same
# transaction. That is precisely how the live Base mainnet stack ended up under
# unilateral deployer control. Use 0 on Anvil only, by leaving this unset.
TIMELOCK_DELAY_SECONDS=172800

# ── DeployDevNet role addresses — all [PROD-REQUIRED] ────────────────────────
# Each must be a distinct address and none may be the deployer.
# GOVERNANCE_MULTISIG  timelock proposer; ultimate admin via the timelock
# OPS_MULTISIG         token PAUSER_ROLE (hot wallet, emergency pause only)
# SUBSCRIBER_ADDRESS   IssuanceManager SUBSCRIBER_ROLE — mint quorum key
# REDEEMER_ADDRESS     IssuanceManager REDEEMER_ROLE  — burn quorum key
#                      MUST differ from SUBSCRIBER_ADDRESS; one address for both
#                      collapses the two-key mint/burn split.
# WHITELIST_ADMIN      IssuanceManager WHITELIST_ADMIN_ROLE (AP onboarding)
# NAV_FEED_OWNER       KaleidoscopeNAVFeed owner (KMS signer that pushes NAV)
# SANCTIONS_LIST       SanctionsOracleMirror. Must be a deployed CONTRACT. Unset on
#                      a dev chain deploys a writable MockSanctionsList instead; on
#                      production that is refused outright.
GOVERNANCE_MULTISIG=0x_GOVERNANCE_SAFE
OPS_MULTISIG=0x_OPS_SAFE
SUBSCRIBER_ADDRESS=0x_MINT_MPC_WALLET
REDEEMER_ADDRESS=0x_BURN_MPC_WALLET
WHITELIST_ADMIN=0x_OPS_SAFE
NAV_FEED_OWNER=0x_KMS_NAV_SIGNER
SANCTIONS_LIST=0x_SANCTIONS_ORACLE_MIRROR

# ── DeployTimelock ───────────────────────────────────────────────────────────
# MULTISIG_ADDRESS          [PROD-REQUIRED] timelock proposer/canceller; not the deployer
# ISSUANCE_MANAGER_ADDRESS  [PROD-REQUIRED] IssuanceManager proxy whose DEFAULT_ADMIN is
#                           handed to the timelock. Unset used to SKIP the hand-over
#                           silently, leaving the deployer as sole admin.
MULTISIG_ADDRESS=0x_GOVERNANCE_SAFE
ISSUANCE_MANAGER_ADDRESS=0x_ISSUANCE_MANAGER_PROXY

# ── DeployNAVFeed ────────────────────────────────────────────────────────────
# FORWARDER_OWNER  [PROD-REQUIRED] owner of NAVFeedForwarder.setUpstreamOracle.
#                  Must be a CONTRACT (a TimelockController) on production — an EOA
#                  here is one key that can repoint the price feed every integrated
#                  lending market reads.
OPERATOR_ADDRESS=0x_NAV_UPDATER
FEED_DESCRIPTION=TLT / USD NAV
FORWARDER_OWNER=0x_TIMELOCK_CONTROLLER

# ── Deployed wallet ───────────────────────────────────────────────────────────
WALLET=0xYOUR_DEPLOYER_WALLET

# ── Core infrastructure ───────────────────────────────────────────────────────
TIMELOCK=0x_TIMELOCK_CONTROLLER_PROXY
ISSUANCE_MANAGER=0x_ISSUANCE_MANAGER_PROXY
FACTORY=0x_TOKEN_FACTORY
MOCK_SANCTIONS=0x_MOCK_SANCTIONS_LIST

# ── TOKEN_CAT — Caterpillar Inc 3.7% 2028 ────────────────────────────────────
TOKEN_CAT=0x_GYLD_BOND_TOKEN_PROXY
NAVFEED_CAT=0x_KALEIDOSCOPE_NAV_FEED
FORWARDER_CAT=0x_NAV_FEED_FORWARDER

# ── TOKEN_C — Citigroup Inc 3.887% 2028 ──────────────────────────────────────
TOKEN_C=0x_GYLD_BOND_TOKEN_PROXY
NAVFEED_C=0x_KALEIDOSCOPE_NAV_FEED
FORWARDER_C=0x_NAV_FEED_FORWARDER

# ── TOKEN_KO — Coca-Cola Co 2.25% 2032 ───────────────────────────────────────
TOKEN_KO=0x_GYLD_BOND_TOKEN_PROXY
NAVFEED_KO=0x_KALEIDOSCOPE_NAV_FEED
FORWARDER_KO=0x_NAV_FEED_FORWARDER

# ── Morpho Sepolia (official) ─────────────────────────────────────────────────
MORPHO=0xd011EE229E7459ba1ddd22631eF7bF528d424A14
IRM=0x8C5dDCD3F601c91D1BF51c8ec26066010ACAbA7c
ORACLE_FACTORY=0xa6c843fc53aAf6EF1d173C4710B26419667bF6CD
USDC=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
CHAINLINK_USDC_USD=0xA2F78ab2355fe2f984D808B5CeE7FD0A93D5270E
LLTV=860000000000000000

# ── Morpho integration (populated after Steps 4 & 5) ─────────────────────────
MORPHO_ORACLE=0x_MORPHO_CHAINLINK_ORACLE_V2
MORPHO_MARKET_ID=0x_KECCAK256_OF_MARKET_PARAMS

# ══════════════════════════════════════════════════════════════════════════════
# BASE MAINNET TEST (branch: base-mainnet-morpho-test)
# See docs/morpho-base-listing.md for the full process.
# ══════════════════════════════════════════════════════════════════════════════

# ── Base RPC + keys ───────────────────────────────────────────────────────────
BASE_RPC=https://mainnet.base.org
BASESCAN_API_KEY=YOUR_BASESCAN_API_KEY

# ── Protocol addresses on Base (official — do not change) ────────────────────
BASE_MORPHO=0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb
BASE_IRM=0x46415998764C29aB2a25CbeA6254146D50D22687
BASE_ORACLE_FACTORY=0x2DC205F24BCb6B311E5cdf0745B0741648Aebd3d
BASE_USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
BASE_LLTV=860000000000000000
# Chainalysis sanctions oracle on Base (different from Ethereum 0x40C5...)
# Source: https://go.chainalysis.com/chainalysis-oracle-docs.html
BASE_CHAINALYSIS=0x3A91A31cB3dC49b4db9Ce721F50a9D076c8D739B

# ── The live Base mainnet test stack (GYL-1135) ──────────────────────────────
# Deployed by contracts/script/DeployBaseTest.s.sol, which has been REMOVED. That
# script hardcoded delay=0, made the deployer the sole timelock proposer, and ran
# initialize(deployer, deployer, deployer) with no hand-over — the incident this
# hardening pass exists to prevent, and a configuration no current script can
# produce. Source: git 18f5ba0; transactions: broadcast/DeployBaseTest.s.sol/8453/.
# These addresses remain here only to identify the affected deployment.
BASE_TIMELOCK=0x_TIMELOCK_CONTROLLER
BASE_ISSUANCE_MANAGER=0x_ISSUANCE_MANAGER_PROXY
BASE_FACTORY=0x_TOKEN_FACTORY
BASE_TOKEN_TBA=0x_TEST_BOND_ALPHA_PROXY
BASE_NAVFEED_TBA=0x_KALEIDOSCOPE_NAV_FEED
BASE_FORWARDER_TBA=0x_NAV_FEED_FORWARDER

# ── Populated by Step 2 (cast send createMorphoChainlinkOracleV2) ─────────────
BASE_MORPHO_ORACLE=0xeD5F6eFb1a4D486642dAc48AC129af5834d7ca6A
BASE_CHAINLINK_USDC_USD=0x7e860098F58bBFC8648a4311b374B1D669a2bc6B

# ── Populated after createMarket() ───────────────────────────────────────────
BASE_MORPHO_MARKET_ID=0x_KECCAK256_OF_MARKET_PARAMS

# ══════════════════════════════════════════════════════════════════════════════
# ATOMIC SWAP (SEPOLIA)
# Deploys the self-custodial GyldAtomicSwap (EIP-712 signed quotes; the contract
# holds its own inventory) via contracts/script/DeployAtomicSettlement.s.sol.
# Sepolia (chainId 11155111) is the single supported public testnet for
# integrator testing. Variable names are exactly what the script reads.
# ══════════════════════════════════════════════════════════════════════════════

# ── Atomic swap — required ────────────────────────────────────────────────────
# Sepolia USDC (6 decimals) — the cash leg every quote is priced against.
USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# IssuanceManager proxy (DeployDevNet output) — the swap is whitelisted as an AP.
EVM_ISSUANCE_MANAGER=0x_ISSUANCE_MANAGER_PROXY

# ── Atomic swap — roles ───────────────────────────────────────────────────────
# All [PROD-REQUIRED]: each falls back to the deployer on a dev chain only, and on
# production none of them may BE the deployer.
# TimelockController that receives DEFAULT_ADMIN. Unset used to skip the hand-over
# with a console warning, leaving the deployer as permanent admin of the contract
# that holds the settlement inventory. It is now a hard error on production.
TIMELOCK_ADDRESS=0x_TIMELOCK_CONTROLLER_PROXY
# PAUSER_ROLE — ops multisig; may pause() only, never unpause().
OPS_MULTISIG=0x_OPS_MULTISIG
# TREASURER_ROLE — ops MPC wallet; withdraw() net inventory to WITHDRAWAL_WALLET.
TREASURER_ADDRESS=0x_OPS_MPC_WALLET
# QUOTE_SIGNER_ROLE — quote-service KMS key that signs EIP-712 SwapMessages.
QUOTE_SIGNER=0x_QUOTE_SERVICE_KMS_KEY
# ALLOWLIST_ADMIN_ROLE — setAllowed only; in prod MUST be the KMS swap-admin key
# (stays live after the timelock handover, GYL-1050).
ALLOWLIST_ADMIN=0x_KMS_SWAP_ADMIN_KEY
# Fixed treasury destination for withdraw(); defaults to TREASURER_ADDRESS (dev).
WITHDRAWAL_WALLET=0x_TREASURY_SAFE

# ── Atomic swap — tuning (optional; script defaults shown) ────────────────────
# Quote-vs-NAV sanity band in basis points (200 = 2%).
MAX_QUOTE_DEVIATION_BPS=200
# Max NAV feed age before executeSwap fails closed with StaleNav (1 day).
MAX_NAV_AGE_SECS=86400

# ── Atomic swap — series + takers (optional) ──────────────────────────────────
# TokenFactory; required only when SERIES_TOKENS is set (forwarder lookup).
EVM_FACTORY_ADDRESS=0x_TOKEN_FACTORY
# Comma-separated GyldBondToken proxies to register with their NAV forwarders.
SERIES_TOKENS=0x_TOKEN_CAT,0x_TOKEN_C,0x_TOKEN_KO
# Comma-separated taker addresses to allowlist for executeSwap.
ALLOWED_TAKERS=0x_AP_WALLET_1,0x_AP_WALLET_2

# ── Atomic swap — output (logged by the script; hand to gateway/integrators) ──
# GyldAtomicSwap proxy — the ONLY address takers approve/permit; it holds the
# settlement inventory.
EVM_ATOMIC_SWAP=0x_GYLD_ATOMIC_SWAP_PROXY
