# BSC MAINNET (56) inputs for BscFordefiStack, hybrid (GLD-978): KMS deployer + Fordefi role vaults. Copy to
# fordefi-roles.bsc-mainnet.env once every value is decided and reviewed. Public: addresses and
# bond data only, no secrets. Every empty value fails closed. Runbook: docs/deploy/bsc-mainnet.md.

# ── Deployer: the PROD AWS KMS key (forge --aws), NOT a Fordefi vault ──────────────────
STACK_DEPLOYER=                # KMS deployer address: sends runA1/A3/C1/C3 (--aws --broadcast); holds no role afterwards
# The PROD Fordefi "Deployer" vault 0xb242Bf9fa856B70365FB43EE780d110f6B9DDAb3 only funds STACK_DEPLOYER
# with BNB; the script refuses it as STACK_DEPLOYER. AWS_REGION / AWS_KMS_KEY_IDS: set in the shell.

# ── PROD Fordefi vaults, one per role, pairwise distinct (and distinct from STACK_DEPLOYER) ──
FORDEFI_CONTRACT_ADMIN=        # timelock proposer + canceller, mirror admin; signs the proof and run B
FORDEFI_FREEZE=                # token PAUSER + DOCUMENT, NAV feed emergencyUpdater
FORDEFI_SWAP_PAUSE=            # swap PAUSER + IssuanceManager ISSUANCE_PAUSER
FORDEFI_NAV_FEEDER=            # NAV feed owner (updateAnswer); signs run C2
FORDEFI_SUBSCRIBER=            # IssuanceManager SUBSCRIBER (mint)
FORDEFI_BURN_ROLE=             # IssuanceManager REDEEMER (burn)
FORDEFI_WHITELISTER=           # IssuanceManager WHITELIST_ADMIN + swap ALLOWLIST_ADMIN; signs run C4
FORDEFI_SWAP_TREASURER=        # swap TREASURER
FORDEFI_QUOTE_SIGNER=          # swap QUOTE_SIGNER (RFQ quotes, off-chain signatures only)
FORDEFI_BLOCKLIST_UPDATER=     # SanctionsOracleMirror SANCTIONS_UPDATER
FORDEFI_SWAP_DISTRIBUTION=     # swap withdrawalWallet

# ── Chain config (OPEN DECISIONS: fill only once signed off) ───────────────────────────
CASH_TOKEN=                    # 0x55d398326f99059fF775485246999027B3197955 (USDT) or 0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d (USDC); both 18 dp
# TIMELOCK_DELAY_SECONDS=172800  # optional; default and floor 48 h, cap 604800 (7 d)
SANCTIONS_FORWARDING_ORACLE=   # Chainalysis oracle on BSC (confirm with Chainalysis before use)
SANCTIONS_PROBE_FLAGGED=       # an address the forwarding oracle flags today (re-check on deploy day)
DEPLOY_SALT_TAG=               # fresh tag, bound into the governance proof

# ── The three bonds (index 0..2). TAG is the gateway env suffix (TOKEN_<TAG>, NAVFEED_<TAG>) ──
# SYMBOL is the on-chain token symbol (testnet uses the CUSIP); the CUSIP must be the ISIN body;
# NAME must contain COUPON verbatim; MATURITY is a unix timestamp in the future.
BOND_0_NAME=
BOND_0_SYMBOL=
BOND_0_CUSIP=
BOND_0_ISIN=
BOND_0_MATURITY=
BOND_0_COUPON=
BOND_0_TAG=
BOND_1_NAME=
BOND_1_SYMBOL=
BOND_1_CUSIP=
BOND_1_ISIN=
BOND_1_MATURITY=
BOND_1_COUPON=
BOND_1_TAG=
BOND_2_NAME=
BOND_2_SYMBOL=
BOND_2_CUSIP=
BOND_2_ISIN=
BOND_2_MATURITY=
BOND_2_COUPON=
BOND_2_TAG=
# First NAV per bond, 8 dp (e.g. 99.85 USD -> 9985000000). No default on 56.
# NAV_ANSWER_8DP_<TAG>=
